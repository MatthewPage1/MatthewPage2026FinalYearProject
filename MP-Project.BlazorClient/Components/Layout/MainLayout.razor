@using System;
@using System.Net.Http;
@using System.Text;
@using System.Text.Json;
@using System.Threading.Tasks;
@inject NavigationManager Nav
@inject ThemeService ThemeService
@inject AuthService AuthService
@inject SimulationService SimulationService
@inject IHttpClientFactory ClientFactory
@implements IDisposable
@inherits LayoutComponentBase


@if (!AuthService.IsLoggedIn && !Nav.Uri.Contains("/log-in"))
{
    Nav.NavigateTo("/log-in", true);
}
else
{
    <AutoRefresh IntervalSeconds="5" OnRefresh="RefreshMoney" OnStateChange="StateHasChanged" />

    <div class="app-container @(ThemeService.CurrentTheme)">

        <div class="sidebar">
            <NavLink href="/dashboard" class="nav-item">Dashboard</NavLink>
            <NavLink href="/item-list" class="nav-item">Item List</NavLink>
            <NavLink href="/inventory-updates" class="nav-item">Inventory Updates</NavLink>
            <NavLink href="/purchases" class="nav-item">Purchases</NavLink>
            <NavLink href="/profile" class="nav-item">Profile</NavLink>
            <NavLink href="/settings" class="nav-item">Settings</NavLink>

            <div class="middle-link">
                <NavLink href="/DEV" class="nav-item">DEV</NavLink>
            </div>
            <div class="bottom-link">
                <NavLink href="/log-in" class="nav-item">Log In / Sign Up</NavLink>
            </div>
        </div>

        <div class="main-content">
            <div class="header-bar">
                <div class="header">
                    Inventory Management System
                </div>

                <div class="header-money">
                    <span>£@Money.ToString("N2")</span>
                </div>
            </div>

            <div class="page-content">
                @Body
            </div>
        </div>

    </div>
}
@code {

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += Refresh;
        SimulationService.OnChange += UpdateMoney;
        Money = SimulationService.CurrentBalance;
    }

    private async void Refresh()
    {
        await InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= Refresh;
        SimulationService.OnChange -= UpdateMoney;
    }

    private decimal Money;

    protected override async Task OnInitializedAsync()
    {

        Money = SimulationService.CurrentBalance;
    }

    private void UpdateMoney()
    {
        Money = SimulationService.CurrentBalance;
        InvokeAsync(StateHasChanged);
    }

    private Task RefreshMoney()
    {
        Money = SimulationService.CurrentBalance;
        return Task.CompletedTask;
    }

    public class FinanceDto
    {
        public decimal Revenue { get; set; }
        public decimal Costs { get; set; }
        public decimal Profit { get; set; }
    }
}