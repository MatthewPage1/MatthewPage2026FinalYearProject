@using System;
@using System.Net.Http;
@using System.Text;
@using System.Text.Json;
@using System.Threading.Tasks;
@inject NavigationManager Nav
@inject ThemeService ThemeService
@inject AuthService AuthService
@inject SimulationService SimulationService
@inject IHttpClientFactory ClientFactory
@implements IDisposable
@inherits LayoutComponentBase


@if (!AuthService.IsLoggedIn && !Nav.Uri.Contains("/log-in"))
{
    Nav.NavigateTo("/log-in", true);
}
else
{
    <AutoRefresh IntervalSeconds="5" OnRefresh="RefreshMoney" OnStateChange="StateHasChanged" />

    <div class="app-container @(ThemeService.CurrentTheme)">

        <div class="sidebar">
            <NavLink href="/dashboard" class="nav-item">Dashboard</NavLink>
            <NavLink href="/item-list" class="nav-item">Item List</NavLink>
            <NavLink href="/inventory-updates" class="nav-item">Inventory Updates</NavLink>
            <NavLink href="/purchases" class="nav-item">Purchases</NavLink>
            <NavLink href="/profile" class="nav-item">Profile</NavLink>

            <div class="middle-link">
                <NavLink href="/DEV" class="nav-item">DEV</NavLink>
            </div>

            <div class="bottom-link">
                @if (AuthService.IsLoggedIn)
                {
                    <div class="nav-item" @onclick="Logout">Log Out</div>
                }
                else
                {
                    <NavLink href="/log-in" class="nav-item">Log In</NavLink>
                }
            </div>

            @if (showLogoutModal)
            {
                <div class="modal-overlay">
                    <div class="logout-modal">

                        <h2>Logged Out</h2>
                        <p>You have been successfully logged out.</p>

                        <button class="modal-btn" @onclick="CloseModal">
                            OK
                        </button>

                    </div>
                </div>
            }
        </div>

        <div class="main-content">
            <div class="header-bar">
                <div class="header">
                    @DisplayNameWithSuffix Inventory Management System
                </div>

                <div class="header-money">
                    <span>£@Money.ToString("N2")</span>
                </div>
            </div>

            <div class="page-content">
                @Body
            </div>
        </div>

    </div>
}
@code {
    private decimal Money;
    private string DisplayNameWithSuffix =>
        AuthService.IsLoggedIn && !string.IsNullOrWhiteSpace(AuthService.DisplayName)
            ? $"{AuthService.DisplayName}'s"
            : "";

    private bool showLogoutModal = false;

    private void Logout()
    {
        AuthService.Logout();
        showLogoutModal = true;
    }

    private void CloseModal()
    {
        showLogoutModal = false;
        Nav.NavigateTo("/login"); 
    }


    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnThemeChanged += Refresh;
        SimulationService.OnChange += UpdateMoney;
        AuthService.OnLoginStateChanged += HandleLoginChange;

        if (AuthService.IsLoggedIn)
        {
            await SimulationService.LoadBalanceAsync(AuthService.UserId);
        }

        Money = SimulationService.CurrentBalance;
    }

    private void Refresh()
    {
        InvokeAsync(StateHasChanged);
    }

    private void UpdateMoney()
    {
        Money = SimulationService.CurrentBalance;
        InvokeAsync(StateHasChanged);
    }

    private Task RefreshMoney()
    {
        InvokeAsync(StateHasChanged);
        return Task.CompletedTask;
    }

    private async void HandleLoginChange()
    {
        if (AuthService.IsLoggedIn)
        {
            await SimulationService.LoadBalanceAsync(AuthService.UserId);
        }

        Money = SimulationService.CurrentBalance;
        await InvokeAsync(StateHasChanged);
    }


    public void Dispose()
    {
        ThemeService.OnThemeChanged -= Refresh;
        SimulationService.OnChange -= UpdateMoney;
        AuthService.OnLoginStateChanged -= HandleLoginChange;
    }


}