@using System;
@using System.Net.Http;
@using System.Text;
@using System.Text.Json;
@using System.Threading.Tasks;

@inject ThemeService ThemeService
@inject IHttpClientFactory ClientFactory
@implements IDisposable
@inherits LayoutComponentBase

<AutoRefresh IntervalSeconds="5" OnRefresh="OnInitializedAsync" OnStateChange="StateHasChanged" />
<div class="app-container @(ThemeService.CurrentTheme)">

    <!-- Sidebar with buttons for each page -->
    <div class="sidebar">
        <NavLink href="/dashboard" class="nav-item">Dashboard</NavLink>
        <NavLink href="/item-list" class="nav-item">Item List</NavLink>
        <NavLink href="/inventory-updates" class="nav-item">Inventory Updates</NavLink>
        <NavLink href="/purchases" class="nav-item">Purchases</NavLink>
        <NavLink href="/profile" class="nav-item">Profile</NavLink>
        <NavLink href="/settings" class="nav-item">Settings</NavLink>

        <div class="middle-link">
            <NavLink href="/DEV" class="nav-item">DEV</NavLink>
        </div>
        <div class="bottom-link">
            <NavLink href="/log-in-sign-up" class="nav-item">Log In / Sign Up</NavLink>
        </div>
    </div>

    <!-- Horizontal Bar Top -->
    <div class="main-content">
        <div class="header-bar">
            <div class="header">
            Inventory Management System
            </div>

            <div class="header-money">
                <span>£@Money.ToString("N2")</span>
            </div>
        </div>
        <div class="page-content">
            @Body
        </div>
    </div>

</div>

@code {
    
    //ensure screens are updated when theme changes
    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += Refresh;
    }

    //refresh screen to allow theme change
    private async void Refresh()
    {
        await InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= Refresh;
    }

    private decimal Money;

    //fetch finance data on load and every 5 seconds to update the profit display
    protected override async Task OnInitializedAsync()
    {
	// login to database to allow finance data to be accessed, this is required as the API is protected by authentication and requires a JWT token to access data, this token is obtained by logging in with the below credentials and is stored in the HttpClient for future requests
        var http = ClientFactory.CreateClient("API");

        var payload = new
        {
           username = "MatthewPage",
           password = "FinalYearProjectHome1$"

           // username = "Test1",
           // password = "Test1Password1$"

        };
        
        
        var response = await http.PostAsJsonAsync("https://localhost:7190/api/auth/login", payload);
        var responseString = await response.Content.ReadAsStringAsync();
        Console.WriteLine(response.StatusCode);
        Console.WriteLine(responseString);
        
        
        // remember if not 200 I need to show a BAD respoonse on logon and not proceed
        //if (response.StatusCode != 200)

        //
        
        var result = await http.GetFromJsonAsync<FinanceDto>("api/products/finances");

        if (result != null)
            Money = result.Profit;
    }

    public class FinanceDto
    {
        public decimal Revenue { get; set; }
        public decimal Costs { get; set; }
        public decimal Profit { get; set; }
    }
}