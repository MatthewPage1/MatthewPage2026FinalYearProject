@page "/"
@page "/dashboard"

@using MP_Project.BlazorClient.Components.Layout
@using Microsoft.AspNetCore.WebUtilities
@inject AuthService AuthService
@inject IHttpClientFactory ClientFactory
@inject IJSRuntime JS

<div class="content-card">

    <!-- Dashboard title -->
    <div class="section-title">
        Dashboard
    </div>

    <!-- Graph -->
    <div id="moneyChart" style="height:400px;"></div>

</div>

@code {
    private List<int> days = new();
    private List<decimal> money = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadData();
            await RenderChart();
        }
    }

    private async Task LoadData()
    {
        var userId = AuthService.UserId;

        if (userId <= 0)
            return;

        var http = ClientFactory.CreateClient("API");

        var query = new Dictionary<string, string?>
        {
            ["currentUserId"] = userId.ToString()
        };

        var url = QueryHelpers.AddQueryString(
            "api/simulation/history/byuser",
            query
        );

        var history = await http.GetFromJsonAsync<List<SimulationHistory>>(url);

        if (history != null && history.Any())
        {
            days = history.Select(x => x.Day).ToList();
            money = history.Select(x => x.Balance).ToList();
        }
    }

    private async Task RenderChart()
    {
        var data = new[]
        {
            new
            {
                x = days,
                y = money,
                type = "scatter",
                mode = "lines+markers",
                name = "Balance"
            }
        };

        var layout = new
        {
            title = "Money Over Time",
            xaxis = new { title = "Day" },
            yaxis = new { title = "Balance (£)" }
        };

        await JS.InvokeVoidAsync("Plotly.newPlot", "moneyChart", data, layout);
    }

    public class SimulationHistory
    {
        public int Id { get; set; }
        public int Day { get; set; }
        public decimal Balance { get; set; }
        public decimal Revenue { get; set; }
        public decimal Costs { get; set; }
        public DateTime Timestamp { get; set; }
        public int UserId { get; set; }
    }
}