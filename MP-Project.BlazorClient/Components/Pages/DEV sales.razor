@page "/DEV"
@using MP_Project.Shared
@inject IHttpClientFactory ClientFactory
@inject SimulationService SimulationService


<div class="content-card">
    <!-- Dev title-->
    <div class="section-title">
        Dev Sales Page
    </div>

    <!--Simulation start / stop buttons-->
    <button class="btn btn-success" @onclick="StartSim">
        Start Simulation
    </button>

    <button class="btn btn-danger" @onclick="StopSim">
        Stop Simulation
    </button>

    <!--List the product ID's and Quantities of each persona-->
    @foreach (var persona in personas)
    {
        <h3>@persona.Name</h3>

        <ul>
            @foreach (var item in persona.ShoppingList)
            {
                <li>
                    Product: @item.ProductId |
                    Qty: @item.Quantity
                </li>
            }
        </ul>
    }
</div>

@code {

    List<Persona> personas = new();

	//fetch the personas to display on the page
    protected override async Task OnInitializedAsync()
    {
        var http = ClientFactory.CreateClient("API");
        personas = await http.GetFromJsonAsync<List<Persona>>("api/personas") ?? new();
    }

    private async Task StartSim()
    {
        await SimulationService.StartSimulation();
    }

    private void StopSim()
    {
        SimulationService.StopSimulation();
    }


}

