@page "/DEV"
@using MP_Project.Shared
@using Microsoft.AspNetCore.WebUtilities
@inject IHttpClientFactory ClientFactory
@inject AuthService AuthService
@inject SimulationService SimulationService


<div class="content-card">
    <div class="section-title">
        Dev Sales Page
    </div>

    <!-- NEW: Simulation settings -->
    <div class="sim-controls">

        <div class="input-group">
            <label>Customers per Day</label>
            <input type="number" min="1" @bind="CustomersPerDay" />

        </div>

        <div class="input-group">
            <label>Day Duration (seconds)</label>
            <input type="number" min="1" @bind="DayDurationSeconds" />
        </div>

        <div class="input-group">
            <label>Number of Days </label>
            <input type="number" min="1" @bind="numDays" />
        </div>

    </div>

    <!-- Buttons -->
    <button class="btn btn-success"
            @onclick="StartSimulation"
            disabled="@SimulationService.IsRunning">
        Start Simulation
    </button>

    <button class="btn btn-danger" @onclick="StopSim">
        Stop Simulation
    </button>

    <!--List the product ID's and Quantities of each persona-->
    @foreach (var persona in personas)
    {
        <h3>@persona.Name</h3>

        <ul>
            @foreach (var item in persona.ShoppingList)
            {
                <li>
                    Product: @item.ProductId |
                    Qty: @item.Quantity
                </li>
            }
        </ul>
    }
</div>

@code {
	int numDays = 1; 
    int CustomersPerDay = 1;
    int DayDurationSeconds = 10;

    List<Persona> personas = new();

    protected override async Task OnInitializedAsync()
    {
        var http = ClientFactory.CreateClient("API");
        personas = await http.GetFromJsonAsync<List<Persona>>("api/personas") ?? new();
    }

    private async Task StartSimulation()
    {
        SimulationService.Stop();
        var http = ClientFactory.CreateClient("API");

        personas = await http.GetFromJsonAsync<List<Persona>>("api/personas") ?? new();
        var userId = AuthService.UserId;

        if (userId <= 0)
        {
            Console.WriteLine("User not logged in");
            return;
        }

        var query = new Dictionary<string, string?>
        {
            ["currentUserId"] = userId.ToString()
        };

        var url = QueryHelpers.AddQueryString(
            "api/products/byuser",
            query
        );

        var products = await http.GetFromJsonAsync<List<Product>>(url);
        Console.WriteLine($"Products: {products?.Count}");

        await SimulationService.RunSimulationAsync(
            days: numDays,
            customersPerDay: CustomersPerDay,
            secondsPerDay: DayDurationSeconds,
            personas: personas!,
            products: products!,
            userId: AuthService.UserId
        );
    }

    private void StopSim()
    {
        SimulationService.Stop();
    }
}

